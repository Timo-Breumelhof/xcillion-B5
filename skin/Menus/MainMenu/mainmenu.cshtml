@using DotNetNuke.Web.DDRMenu;
@using System.Dynamic;
@inherits DotNetNuke.Web.Razor.DotNetNukeWebPage<dynamic>

<ul class="navbar-nav ms-auto mt-2 mt-lg-0" id="nav-desktop">
    @RenderPages(Model.Source.root.Children)
</ul>

@functions{


        string getValidClassName(string Text){
            if (string.IsNullOrWhiteSpace(Text)) return "unnamed";

            var s = Text.ToLowerInvariant().Trim();

            // Replace invalid characters with hyphen
            s = System.Text.RegularExpressions.Regex.Replace(s, @"[^a-z0-9_\-]+", "-");
            // Collapse multiple hyphens
            s = System.Text.RegularExpressions.Regex.Replace(s, "-{2,}", "-");
            // Trim edges
            s = s.Trim('-','_');

            if (string.IsNullOrEmpty(s)) return "unnamed";

            // Ensure it starts with a letter or underscore
            if (!(char.IsLetter(s[0]) || s[0] == '_')) s = "_" + s;

            return s;
        }

}

@helper RenderPages(IEnumerable<MenuNode> pages)
{
    if (!pages.Any())
    {

        return;
    }

    foreach (var page in pages)
    {

        var hasChildren = page.HasChildren();
        HtmlString attrTarget = Html.Raw(!string.IsNullOrEmpty(page.Target) ? ("target=\"" + page.Target + "\"") : string.Empty);
        HtmlString href = null;

        var enabledClass = "";

        if (page.Enabled){

            href = Html.Raw(String.Concat("href=\"", page.Url, "\""));

        }else{

            enabledClass = "disabled";

        }


        var lastClass = page.Last ? "dropdown-menu-end" : null;
        var bcClass = page.Breadcrumb && !page.Selected ? " active-parent" : null;
        var activeClass= page.Selected ? " active" : null;
        var levelClass = "nav-level-" + page.Depth;

        var pageNameClass = "";

        if(page.Depth == 0){
           pageNameClass = "page-name-" + getValidClassName(page.Text);
        }

        var levelClassChild = "nav-wrap-level-" + (page.Depth + 1);

        // Sub-level toggles (depth > 0) use data-bs-display="static" so Popper is
        // disabled and CSS + JS control the right/left positioning instead.
        var toggleDisplay = page.Depth > 0 ? "data-bs-display=\"static\"" : "";

        <li class='nav-item @levelClass @activeClass @bcClass @pageNameClass'>
                @if (hasChildren && page.Text.ToLower() != "leden"){
                    <a class="nav-link @levelClass @enabledClass @activeClass @bcClass" @href @attrTarget><span class="link-text">@page.Text</span></a>

                    <span class="dropdown-toggle" role="button" data-bs-auto-close="outside" data-bs-toggle="dropdown" @Html.Raw(toggleDisplay) aria-haspopup="true" aria-expanded="false"></span>

                    <ul id="childmenu-@page.TabId" class="dropdown-menu @lastClass @levelClassChild">
                        @RenderPages(page.Children)
                    </ul>
                }else{
                     <a class="nav-link @levelClass @enabledClass @activeClass @bcClass" @href @attrTarget><span class="link-text">@page.Text</span></a>
                }


        </li>


    }
}
