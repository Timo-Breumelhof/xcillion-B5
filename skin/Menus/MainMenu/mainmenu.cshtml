@using DotNetNuke.Web.DDRMenu;
@using System.Dynamic;
@inherits DotNetNuke.Web.Razor.DotNetNukeWebPage<dynamic>

<ul class="navbar-nav ms-auto mt-4 mt-lg-0" id="nav-main">
    @RenderPages(Model.Source.root.Children)
</ul>

@functions{


        string getValidClassName(string Text){
            if (string.IsNullOrWhiteSpace(Text)) return "unnamed";

            var s = Text.ToLowerInvariant().Trim();

            // Replace invalid characters with hyphen
            s = System.Text.RegularExpressions.Regex.Replace(s, @"[^a-z0-9_\-]+", "-");
            // Collapse multiple hyphens
            s = System.Text.RegularExpressions.Regex.Replace(s, "-{2,}", "-");
            // Trim edges
            s = s.Trim('-','_');

            if (string.IsNullOrEmpty(s)) return "unnamed";

            // Ensure it starts with a letter or underscore
            if (!(char.IsLetter(s[0]) || s[0] == '_')) s = "_" + s;

            return s;
        }

}

@helper RenderPages(IEnumerable<MenuNode> pages)
{
    if (!pages.Any())
    {

        return;
    }

    foreach (var page in pages)
    {

        var hasChildren = page.HasChildren();
        HtmlString attrTarget = Html.Raw(!string.IsNullOrEmpty(page.Target) ? ("target=\"" + page.Target + "\"") : string.Empty);
        HtmlString href = null;

        var enabledClass = "";

        if (page.Enabled){

            href = Html.Raw(String.Concat("href=\"", page.Url, "\""));

        }else{

            enabledClass = "disabled";

        }


        var isActive = page.Selected;
        var isActiveParent = page.Breadcrumb && !page.Selected;
        var levelClass = "nav-level-" + page.Depth;

        var pageNameClass = "";

        if(page.Depth == 0){
           pageNameClass = "page-name-" + getValidClassName(page.Text);
        }

        var levelClassChild = "nav-wrap-level-" + (page.Depth + 1);
        var childMenuId = "childmenu-" + page.TabId;

        // Build each class attribute as a single precomputed string rather than
        // interpolating loose loop variables inline — @helper output is lazily
        // evaluated, and multi-expression attributes referencing per-iteration
        // locals directly can end up reflecting the wrong node once recursion
        // defers the actual write.
        var liClasses = new List<string> { "nav-item-li", levelClass };
        if (isActive) { liClasses.Add("active"); }
        if (isActiveParent) { liClasses.Add("active-parent"); }
        if (!string.IsNullOrEmpty(pageNameClass)) { liClasses.Add(pageNameClass); }
        var liClassAttr = Html.Raw("class=\"" + String.Join(" ", liClasses) + "\"");

        var linkClasses = new List<string> { "nav-link", levelClass };
        if (!string.IsNullOrEmpty(enabledClass)) { linkClasses.Add(enabledClass); }
        if (isActive) { linkClasses.Add("active"); }
        if (isActiveParent) { linkClasses.Add("active-parent"); }
        var linkClassAttr = Html.Raw("class=\"" + String.Join(" ", linkClasses) + "\"");

        var itemClasses = new List<string> { "nav-item", levelClass };
        if (!string.IsNullOrEmpty(enabledClass)) { itemClasses.Add(enabledClass); }
        if (isActive) { itemClasses.Add("active"); }
        if (isActiveParent) { itemClasses.Add("active-parent"); }
        var itemClassAttr = Html.Raw("class=\"" + String.Join(" ", itemClasses) + "\"");

        // "collapse" (toggled by id via data-bs-target) rather than Bootstrap's
        // "dropdown" component, since dropdown requires the toggle and menu to
        // be DOM siblings, which conflicts with the flex row wrapping the link
        // and toggle icon. Collapse has no such requirement.
        var ulClasses = new List<string> { "dropdown-menu", "collapse" };
        if (page.Last) { ulClasses.Add("dropdown-menu-end"); }
        ulClasses.Add(levelClassChild);
        var ulClassAttr = Html.Raw("class=\"" + String.Join(" ", ulClasses) + "\"");

        <li @liClassAttr>
                <div @itemClassAttr>
                    <a @linkClassAttr @href @attrTarget><span class="link-text">@page.Text</span></a>
                    @if (hasChildren){
                    <span class="dropdown-toggle" role="button" data-bs-toggle="collapse" data-bs-target="#@childMenuId" aria-controls="@childMenuId" aria-expanded="false"></span>
                    }
                </div>
                @if (hasChildren){
                <ul id="@childMenuId" @ulClassAttr>
                    @RenderPages(page.Children)
                </ul>
                }
        </li>


    }
}
